---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/layout/SiteHeader.astro';
import ChapterNav from '../../../components/chapter/ChapterNav.astro';
import ModelHost from '../../../renderers/ModelHost.astro';
import ChapterDrawer from '../../../components/home/ChapterDrawer.vue';
import StageLoading from '../../../components/home/StageLoading.vue';
import { getAllSections, getKnowledgeTree, getOutline } from '../../../lib/knowledge.js';

/**
 * 一个动态路由生成全部章节页 ——
 * 加一节只需要改章节目录里的 index.md + 放一个 JSON，这里一个字都不用动。
 */
export function getStaticPaths() {
  return getAllSections().map((section) => ({
    params: { chapter: section.chapterSlug, section: section.slug },
    props: { section },
  }));
}

const { section } = Astro.props;
const tree = getKnowledgeTree();
const chapter = tree.chapters.find((c) => c.slug === section.chapterSlug);
const index = chapter.sections.findIndex((s) => s.slug === section.slug);
const prev = chapter.sections[index - 1] ?? null;
const nextSection = chapter.sections[index + 1] ?? null;
const outline = getOutline();
---

<BaseLayout title={`${section.id} ${section.title} · ${chapter.title}`}>
  <SiteHeader />

  <main class="page">
    <ChapterNav chapter={chapter} section={section} prev={prev} next={nextSection}>
      <!-- 小节之间互相跳转：把首页那个抽屉搬到面包屑这一行右侧 -->
      <ChapterDrawer
        slot="actions"
        client:load
        variant="inline"
        outline={outline}
        current={section.href}
      />
    </ChapterNav>

    <h1 class="page__title">
      <span class="page__id num">{section.id}</span>
      {section.title}
    </h1>

    <div class="page__stage">
      <ModelHost model={section.model} />
    </div>
  </main>

  <StageLoading client:load />
</BaseLayout>

<style>
.page {
  max-width: 1080px;
  margin: 0 auto;
  padding: var(--sp-6) var(--sp-5) var(--sp-8);
  display: flex;
  flex-direction: column;
  gap: var(--sp-5);
}

.page__title {
  display: flex;
  align-items: baseline;
  gap: var(--sp-3);
  font-size: var(--fs-xl);
}

.page__id {
  font-size: var(--fs-md);
  color: var(--accent-text);
  font-weight: 500;
}

/* 模型区容器：高度用 svh，保证移动端地址栏收起时不被裁掉 */
.page__stage {
  height: clamp(340px, 62svh, 700px);
}

@media (max-width: 640px) {
  .page {
    padding: var(--sp-4) var(--sp-4) var(--sp-7);
  }
  .page__title {
    font-size: var(--fs-lg);
  }
}
</style>
